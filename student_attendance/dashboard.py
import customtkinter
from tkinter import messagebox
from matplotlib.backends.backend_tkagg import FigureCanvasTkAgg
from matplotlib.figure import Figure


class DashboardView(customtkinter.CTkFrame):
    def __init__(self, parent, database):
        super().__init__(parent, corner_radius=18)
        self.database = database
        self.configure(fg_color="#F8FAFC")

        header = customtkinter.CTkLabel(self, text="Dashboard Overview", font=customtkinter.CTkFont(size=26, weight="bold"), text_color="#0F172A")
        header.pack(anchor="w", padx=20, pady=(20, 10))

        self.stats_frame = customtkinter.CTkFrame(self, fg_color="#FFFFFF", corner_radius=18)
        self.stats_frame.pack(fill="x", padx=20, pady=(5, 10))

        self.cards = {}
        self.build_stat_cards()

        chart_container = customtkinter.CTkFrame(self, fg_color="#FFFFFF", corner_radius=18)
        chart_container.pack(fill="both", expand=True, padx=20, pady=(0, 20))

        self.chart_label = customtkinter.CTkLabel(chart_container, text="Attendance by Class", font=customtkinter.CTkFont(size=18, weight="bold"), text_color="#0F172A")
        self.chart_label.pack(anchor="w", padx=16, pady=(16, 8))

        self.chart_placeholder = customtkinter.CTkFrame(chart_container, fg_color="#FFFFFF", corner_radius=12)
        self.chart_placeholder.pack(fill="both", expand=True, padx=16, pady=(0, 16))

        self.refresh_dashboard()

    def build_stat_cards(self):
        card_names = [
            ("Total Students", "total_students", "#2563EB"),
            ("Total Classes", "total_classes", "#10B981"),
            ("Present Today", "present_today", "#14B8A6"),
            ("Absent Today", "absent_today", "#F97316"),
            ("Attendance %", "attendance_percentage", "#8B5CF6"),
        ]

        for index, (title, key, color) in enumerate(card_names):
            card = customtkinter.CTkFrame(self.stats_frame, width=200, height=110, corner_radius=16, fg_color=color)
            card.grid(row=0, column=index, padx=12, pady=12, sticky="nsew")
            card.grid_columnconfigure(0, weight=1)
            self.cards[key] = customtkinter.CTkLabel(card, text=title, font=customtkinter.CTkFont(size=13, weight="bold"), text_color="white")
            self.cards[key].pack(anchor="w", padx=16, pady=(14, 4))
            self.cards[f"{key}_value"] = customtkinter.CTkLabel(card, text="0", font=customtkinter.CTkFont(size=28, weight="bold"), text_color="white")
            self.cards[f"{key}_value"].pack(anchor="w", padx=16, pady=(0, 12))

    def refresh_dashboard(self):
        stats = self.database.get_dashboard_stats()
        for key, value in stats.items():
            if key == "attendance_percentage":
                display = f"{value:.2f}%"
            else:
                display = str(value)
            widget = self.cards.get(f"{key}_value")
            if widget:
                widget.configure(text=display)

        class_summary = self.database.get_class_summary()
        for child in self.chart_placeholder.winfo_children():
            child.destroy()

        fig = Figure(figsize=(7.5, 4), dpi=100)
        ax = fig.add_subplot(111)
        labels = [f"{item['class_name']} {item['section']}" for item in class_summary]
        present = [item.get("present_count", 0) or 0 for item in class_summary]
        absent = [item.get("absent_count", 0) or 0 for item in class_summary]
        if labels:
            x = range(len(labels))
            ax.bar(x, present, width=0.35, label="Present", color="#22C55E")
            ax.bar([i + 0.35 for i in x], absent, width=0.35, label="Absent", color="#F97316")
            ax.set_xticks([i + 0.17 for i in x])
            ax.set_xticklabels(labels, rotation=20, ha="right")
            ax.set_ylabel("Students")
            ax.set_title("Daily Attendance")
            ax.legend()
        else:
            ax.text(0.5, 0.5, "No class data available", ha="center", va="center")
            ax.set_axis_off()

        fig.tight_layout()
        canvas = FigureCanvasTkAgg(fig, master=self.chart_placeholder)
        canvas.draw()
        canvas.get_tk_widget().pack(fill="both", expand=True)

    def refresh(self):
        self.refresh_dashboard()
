import customtkinter
from tkinter import messagebox


class LoginFrame(customtkinter.CTkFrame):
    def __init__(self, parent, database, login_callback):
        super().__init__(parent, corner_radius=20)
        self.database = database
        self.login_callback = login_callback
        self.configure(fg_color="#F3F7FF")

        title = customtkinter.CTkLabel(self, text="Student Attendance System", font=customtkinter.CTkFont(size=26, weight="bold"), text_color="#0E3A8A")
        title.pack(pady=(30, 10))

        subtitle = customtkinter.CTkLabel(self, text="Secure Teacher & Admin Portal", font=customtkinter.CTkFont(size=13), text_color="#4B5563")
        subtitle.pack(pady=(0, 20))

        form = customtkinter.CTkFrame(self, corner_radius=18, fg_color="#FFFFFF")
        form.pack(fill="both", expand=True, padx=24, pady=(0, 24))

        customtkinter.CTkLabel(form, text="Username", anchor="w").pack(anchor="w", padx=20, pady=(20, 4))
        self.username_entry = customtkinter.CTkEntry(form, width=360, height=42, placeholder_text="Enter username")
        self.username_entry.pack(padx=20, pady=(0, 12), fill="x")

        customtkinter.CTkLabel(form, text="Password", anchor="w").pack(anchor="w", padx=20, pady=(8, 4))
        self.password_entry = customtkinter.CTkEntry(form, width=360, height=42, placeholder_text="Enter password", show="*")
        self.password_entry.pack(padx=20, pady=(0, 20), fill="x")

        self.login_button = customtkinter.CTkButton(
            form,
            text="Login",
            width=360,
            height=44,
            corner_radius=12,
            fg_color="#2563EB",
            hover_color="#1D4ED8",
            command=self.attempt_login,
        )
        self.login_button.pack(padx=20, pady=(0, 18))

        self.username_entry.bind("<Return>", lambda event: self.attempt_login())
        self.password_entry.bind("<Return>", lambda event: self.attempt_login())

    def attempt_login(self):
        username = self.username_entry.get().strip()
        password = self.password_entry.get().strip()

        if not username or not password:
            messagebox.showerror("Validation Error", "Please enter both username and password.")
            return

        user = self.database.authenticate_user(username, password)
        if not user:
            messagebox.showerror("Login Failed", "Invalid username or password.")
            return

        self.login_callback(user)


class PasswordChangeDialog(customtkinter.CTkToplevel):
    def __init__(self, parent, database, username):
        super().__init__(parent)
        self.title("Update Password")
        self.geometry("420x310")
        self.database = database
        self.username = username
        self.resizable(False, False)

        customtkinter.CTkLabel(self, text="Password Change Required", font=customtkinter.CTkFont(size=22, weight="bold"), text_color="#0E3A8A").pack(pady=(20, 10))
        customtkinter.CTkLabel(self, text="Please set a new password before continuing.", text_color="#4B5563").pack(pady=(0, 18))

        customtkinter.CTkLabel(self, text="New Password", anchor="w").pack(anchor="w", padx=20, pady=(0, 5))
        self.new_password = customtkinter.CTkEntry(self, width=300, height=40, show="*")
        self.new_password.pack(padx=20, pady=(0, 12), fill="x")

        customtkinter.CTkLabel(self, text="Confirm Password", anchor="w").pack(anchor="w", padx=20, pady=(0, 5))
        self.confirm_password = customtkinter.CTkEntry(self, width=300, height=40, show="*")
        self.confirm_password.pack(padx=20, pady=(0, 12), fill="x")

        save_button = customtkinter.CTkButton(self, text="Save Password", command=self.change_password)
        save_button.pack(pady=20)

    def change_password(self):
        new_password = self.new_password.get().strip()
        confirm_password = self.confirm_password.get().strip()

        if len(new_password) < 6:
            messagebox.showerror("Password Error", "Password must be at least 6 characters long.")
            return

        if new_password != confirm_password:
            messagebox.showerror("Password Error", "Passwords do not match.")
            return

        self.database.update_password(self.username, new_password)
        messagebox.showinfo("Password Updated", "Your password has been updated successfully.")
        self.destroy()
